# PocketBase Configuration
# =========================

# Public URL - Used by the browser to connect to PocketBase
# This should be your Cloudflare Tunnel URL
NEXT_PUBLIC_POCKETBASE_URL=https://pb.yourdomain.com

# Internal URL (optional) - Used by server-side code for faster internal communication
# This is the internal Kubernetes service URL
# POCKETBASE_URL=http://pocketbase-service.wallet-app.svc.cluster.local:8090

# AI Configuration (optional)
# ===========================
# Google Gemini API Key for AI features
# GEMINI_API_KEY=your_gemini_api_key
