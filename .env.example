# PocketBase Configuration
# =========================
# Note: PocketBase is NOT exposed publicly. All communication goes through Next.js API routes.

# Local Development (use docker-compose.pb.yml to start PocketBase)
POCKETBASE_URL=http://localhost:8090

# Production (K8s internal service - uncomment for production)
# POCKETBASE_URL=http://pocketbase-service.wallet-app.svc.cluster.local:8090

# AI Configuration (server-side only)
# ===================================
# User model choice is stored in app settings.
# API keys stay on server (Kubernetes Secret / .env), never in browser.
#
# Required (per-user mapping by user id OR email):
# ZAI_API_KEYS_JSON={"admin@wallet.local":"sk-xxx","another-user@wallet.local":"sk-yyy"}
#
# Optional fallback key used if user not found in mapping:
# ZAI_API_KEY=sk-global-fallback
#
# Optional model/base-url defaults:
# AI_DEFAULT_MODEL=glm-5
# Supported model values: glm-5, glm-5-turbo, glm-4.7
# ZAI_OPENAI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Registration Policy (internal-use control)
# ==========================================
# Default recommended for internal app: false
AUTH_REGISTRATION_ENABLED=false

# Optional allowlist (used only when AUTH_REGISTRATION_ENABLED=true)
# AUTH_ALLOWED_EMAILS=alice@company.com,bob@company.com
# AUTH_ALLOWED_DOMAINS=company.com
